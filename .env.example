# SchemaBridge application
SCHEMABRIDGE_ENVIRONMENT=development
SCHEMABRIDGE_LOG_LEVEL=INFO
SCHEMABRIDGE_MAX_QUERY_ROWS=500
SCHEMABRIDGE_STATEMENT_TIMEOUT_MS=5000
SCHEMABRIDGE_MAX_QUERY_TABLES=3
SCHEMABRIDGE_DRAFT_STORE_PATH=.local/schemabridge.db

# Demo PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
POSTGRES_DB=schemabridge
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_READER_USER=schemabridge_reader
POSTGRES_READER_PASSWORD=schemabridge_reader
DATABASE_URL=postgresql://schemabridge_reader:schemabridge_reader@localhost:55433/schemabridge

# DataHub Core / MCP
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
TOOLS_IS_MUTATION_ENABLED=false
SAVE_DOCUMENT_TOOL_ENABLED=false
DATAHUB_MCP_DOCUMENT_TOOLS_DISABLED=true
LOGICAL_MODELS_ENABLED=true

# Optional M11 live typed-intent adapter. The default fake needs neither value.
OPENAI_API_KEY=
SCHEMABRIDGE_LLM_MODEL=
