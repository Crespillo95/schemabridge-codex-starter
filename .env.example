# SchemaBridge application
SCHEMABRIDGE_ENVIRONMENT=development
SCHEMABRIDGE_COMPONENT=web
SCHEMABRIDGE_LOG_LEVEL=INFO
SCHEMABRIDGE_MAX_QUERY_ROWS=500
SCHEMABRIDGE_STATEMENT_TIMEOUT_MS=5000
SCHEMABRIDGE_MAX_QUERY_TABLES=3
SCHEMABRIDGE_DRAFT_STORE_PATH=.local/schemabridge.db
SCHEMABRIDGE_AUTH_MODE=local-demo
SCHEMABRIDGE_CATALOG_MODE=recorded
SCHEMABRIDGE_REGISTRY_MODE=recorded
SCHEMABRIDGE_SEMANTIC_REGISTRY_SELECTION=fixed
SCHEMABRIDGE_PUBLICATION_MODE=fake
SCHEMABRIDGE_JUDGE_EXECUTION=recorded
# Deliberate development-only drill; leave false for the normal local/demo path.
SCHEMABRIDGE_ALLOW_LOCAL_LIVE_READS=false
SCHEMABRIDGE_LOCAL_WORKSPACE=local-demo
SCHEMABRIDGE_LOCAL_ROLES=["analyst","publisher"]
SCHEMABRIDGE_RELEASE_REF=working-tree-uncommitted
SCHEMABRIDGE_SEMANTIC_REGISTRY_ID=synthetic_enterprise
SCHEMABRIDGE_SEMANTIC_REGISTRY_CATALOG_SCOPE=synthetic-demo
SCHEMABRIDGE_SEMANTIC_REGISTRY_MANIFEST_PATH=demo/ground_truth/registries/manifest.yml
SCHEMABRIDGE_SEMANTIC_REGISTRY_VERSION=1
# Development-only reader file. Managed active runtimes must use the remote,
# exact-version registry-reader document below and cannot fall back to this path.
SCHEMABRIDGE_SEMANTIC_REGISTRY_READER_ENV_PATH=.local/datahub/mcp.env

# Durable control plane. Development defaults remain local/fixed. Staging and
# production require postgres/active plus separate secret-managed credentials.
SCHEMABRIDGE_CONTROL_PLANE_MODE=local
SCHEMABRIDGE_CONTROL_PLANE_SCHEMA=schemabridge_control
SCHEMABRIDGE_CONTROL_PLANE_SCHEMA_VERSION=14
# Local development may use one capability-specific owner-only directory.
# Managed execution, profile, catalog, and web-preflight processes instead
# require the remote exact-version resolver and projected workload identity;
# they cannot fall back to this directory.
SCHEMABRIDGE_CONNECTOR_SECRET_MODE=local
# SCHEMABRIDGE_CONNECTOR_SECRET_DIRECTORY=/absolute/component-specific/path
# SCHEMABRIDGE_CONNECTOR_SECRET_PROVIDER_URL=https://secrets.example.invalid
# SCHEMABRIDGE_CONNECTOR_SECRET_ROLE=schemabridge-component
# SCHEMABRIDGE_CONNECTOR_SECRET_KV_MOUNT=tenant-connectors
# SCHEMABRIDGE_CONNECTOR_SECRET_CAPABILITY=execution
# SCHEMABRIDGE_CONNECTOR_SECRET_CA_BUNDLE=/absolute/read-only/provider-ca.crt
# Managed web, worker/profile, and reconciler runtimes use a distinct
# registry-reader role plus one opaque binding and immutable provider version.
# SCHEMABRIDGE_SEMANTIC_REGISTRY_SECRET_ROLE=schemabridge-registry-reader
# SCHEMABRIDGE_SEMANTIC_REGISTRY_SECRET_BINDING_REF=registry.reader.primary
# SCHEMABRIDGE_SEMANTIC_REGISTRY_SECRET_VERSION=17
# The dedicated publisher uses a different secret capability and writer document.
# Local development may use the owner-only writer file; managed publisher pods must
# instead configure the exact remote role, binding, and immutable version.
SCHEMABRIDGE_REGISTRY_PUBLISHER_WRITER_ENV_PATH=.local/datahub/writer.env
# SCHEMABRIDGE_REGISTRY_PUBLISHER_SECRET_ROLE=schemabridge-registry-publisher
# SCHEMABRIDGE_REGISTRY_PUBLISHER_SECRET_BINDING_REF=registry.writer.primary
# SCHEMABRIDGE_REGISTRY_PUBLISHER_SECRET_VERSION=1
SCHEMABRIDGE_CONNECTOR_SECRET_TIMEOUT_SECONDS=5
# SCHEMABRIDGE_WORKLOAD_IDENTITY_TOKEN_FILE=/absolute/projected/token
# SCHEMABRIDGE_WORKLOAD_IDENTITY_ROOT=/absolute/projected
# SCHEMABRIDGE_WORKLOAD_IDENTITY_AUDIENCE=schemabridge-secret-manager
# SCHEMABRIDGE_CONTROL_DATABASE_URL=
# SCHEMABRIDGE_CONTROL_RECONCILER_DATABASE_URL=
# SCHEMABRIDGE_CONTROL_MIGRATOR_DATABASE_URL=
# API, worker, and catalog indexer are distinct least-privilege roles on the
# same control database.
# SCHEMABRIDGE_CONTROL_API_DATABASE_URL=
# SCHEMABRIDGE_CONTROL_WORKER_DATABASE_URL=
# SCHEMABRIDGE_CONTROL_PUBLISHER_DATABASE_URL=
# SCHEMABRIDGE_CONTROL_CATALOG_DATABASE_URL=
# Observer-only aggregate/read-only credential. Do not inject any source,
# DataHub, OIDC, LLM, signing, or connector-secret credential into this process.
# SCHEMABRIDGE_CONTROL_OBSERVER_DATABASE_URL=
# Bounded per-process pool. Deployment capacity is max size multiplied by the
# explicitly bounded replica count for each workload.
SCHEMABRIDGE_CONTROL_POOL_MIN_SIZE=1
SCHEMABRIDGE_CONTROL_POOL_MAX_SIZE=8
SCHEMABRIDGE_CONTROL_POOL_MAX_WAITING=32
SCHEMABRIDGE_CONTROL_POOL_ACQUISITION_TIMEOUT_SECONDS=2
SCHEMABRIDGE_CONTROL_POOL_STARTUP_TIMEOUT_SECONDS=10
SCHEMABRIDGE_CONTROL_POOL_CLOSE_TIMEOUT_SECONDS=5
SCHEMABRIDGE_CONTROL_POOL_MAX_IDLE_SECONDS=300
SCHEMABRIDGE_CONTROL_POOL_MAX_LIFETIME_SECONDS=1800
# Restore is a distinct fresh target and is never accepted as a CLI argument.
# SCHEMABRIDGE_CONTROL_RESTORE_DATABASE_URL=
# Independent secret-manager values; never commit real keys.
# SCHEMABRIDGE_CONTROL_AUDIT_SIGNING_KEY=
SCHEMABRIDGE_CONTROL_AUDIT_KEY_VERSION=v1
# SCHEMABRIDGE_IDENTITY_MIGRATION_KEY=
SCHEMABRIDGE_IDENTITY_MIGRATION_KEY_VERSION=v1
SCHEMABRIDGE_IDENTITY_POLICY_VERSION=v1
# Managed operator jobs inject one verified opaque workload actor and roles.
# The web process must not receive these values.
# SCHEMABRIDGE_CONTROL_OPERATOR_ACTOR_ID=
SCHEMABRIDGE_CONTROL_OPERATOR_ROLES=[]

# Production/staging identity metadata. OIDC client/cookie secrets belong only
# in the untracked .streamlit/secrets.toml; see secrets.toml.example.
# SCHEMABRIDGE_OIDC_ISSUER=
# SCHEMABRIDGE_OIDC_AUDIENCE=
# SCHEMABRIDGE_OIDC_PROVIDER=
SCHEMABRIDGE_OIDC_ROLE_CLAIM=roles
SCHEMABRIDGE_OIDC_TENANT_CLAIM=tenant_id
SCHEMABRIDGE_OIDC_ALLOWED_GROUPS={}
# JSON array decoded to the bounded tuple of exact tenant claims accepted here.
SCHEMABRIDGE_OIDC_ALLOWED_TENANTS=[]
SCHEMABRIDGE_OIDC_MAX_SESSION_AGE_SECONDS=3600
SCHEMABRIDGE_OIDC_LIVE_PUBLICATION_MAX_IDENTITY_AGE_SECONDS=900
# Signed bearer verification for the HTTP API. Managed profiles require a
# same-origin HTTPS JWKS URL and a fixed asymmetric allowlist.
# SCHEMABRIDGE_API_OIDC_JWKS_URL=
SCHEMABRIDGE_API_OIDC_ALGORITHMS=["RS256"]
# Inject from the deployment secret manager; never commit the real key.
# SCHEMABRIDGE_PSEUDONYMIZATION_KEY=
SCHEMABRIDGE_PSEUDONYMIZATION_KEY_VERSION=v1

# Authenticated API and durable execution worker. The local bearer token is a
# development-only secret and is forbidden in every managed profile. Dedicated
# API/worker workloads receive only their own variables and never load this
# shared file.
# SCHEMABRIDGE_API_LOCAL_BEARER_TOKEN=
SCHEMABRIDGE_API_BIND_HOST=127.0.0.1
SCHEMABRIDGE_API_PORT=8520
SCHEMABRIDGE_API_ALLOWED_HOSTS=["127.0.0.1","localhost"]
SCHEMABRIDGE_API_MAX_REQUEST_BYTES=65536
SCHEMABRIDGE_API_LIMIT_CONCURRENCY=100
SCHEMABRIDGE_API_GRACEFUL_SHUTDOWN_SECONDS=20
SCHEMABRIDGE_API_DOCS_ENABLED=false
SCHEMABRIDGE_API_JOB_AUTHORIZATION_TTL_SECONDS=300
SCHEMABRIDGE_REGISTRY_PUBLISHER_ID=registry-publisher-local
SCHEMABRIDGE_REGISTRY_PUBLISHER_LEASE_SECONDS=60
SCHEMABRIDGE_REGISTRY_PUBLISHER_HEARTBEAT_SECONDS=20
SCHEMABRIDGE_REGISTRY_PUBLISHER_POLL_INTERVAL_MS=500
# Internal aggregate observer; bind 0.0.0.0 only behind the reviewed
# monitoring-only NetworkPolicy and ServiceMonitor.
SCHEMABRIDGE_OBSERVER_BIND_HOST=127.0.0.1
SCHEMABRIDGE_OBSERVER_PORT=9464
SCHEMABRIDGE_OBSERVER_LIMIT_CONCURRENCY=20
SCHEMABRIDGE_OBSERVER_GRACEFUL_SHUTDOWN_SECONDS=20
SCHEMABRIDGE_OBSERVER_SNAPSHOT_TIMEOUT_MS=2000
SCHEMABRIDGE_OBSERVER_MAX_METRICS_RESPONSE_BYTES=65536
# Internal process-local exporter used by API, execution, catalog, profile, and
# reconciliation pods. Production binds 0.0.0.0 only behind monitoring-only
# NetworkPolicy; local development remains loopback-only.
SCHEMABRIDGE_PROCESS_METRICS_BIND_HOST=127.0.0.1
SCHEMABRIDGE_PROCESS_METRICS_PORT=9464
SCHEMABRIDGE_PROCESS_METRICS_MAX_RESPONSE_BYTES=65536
SCHEMABRIDGE_WORKER_ID=worker-local
# Non-secret routing policy. Managed workers must use verified-oidc; the
# development exact-local mode deliberately does not follow identity aliases.
SCHEMABRIDGE_WORKER_IDENTITY_LINEAGE_MODE=exact-local
SCHEMABRIDGE_WORKER_LEASE_SECONDS=120
SCHEMABRIDGE_WORKER_HEARTBEAT_SECONDS=30
SCHEMABRIDGE_WORKER_MAX_ATTEMPTS=3
SCHEMABRIDGE_WORKER_POLL_INTERVAL_MS=500
# M28 aggregate-only join-profile workers claim target-bearing jobs dynamically.
# They reuse the worker control role and their profile-only connector directory,
# but receive no global source DSN, DataHub, OpenAI, API, OIDC, or audit secret.
SCHEMABRIDGE_SEMANTIC_PROFILE_MAX_ATTEMPTS=5
SCHEMABRIDGE_SEMANTIC_PROFILE_RETENTION_DAYS=30
SCHEMABRIDGE_SEMANTIC_PROFILE_MAINTENANCE_BATCH_SIZE=100
# M26 semantic reconciler. A managed process derives this lease owner from its
# pod name and receives only the reconciler control role plus the audit key.
SCHEMABRIDGE_SEMANTIC_RECONCILER_ID=semantic-reconciler-local
SCHEMABRIDGE_SEMANTIC_RECONCILER_LEASE_SECONDS=60
SCHEMABRIDGE_SEMANTIC_RECONCILER_POLL_INTERVAL_MS=1000
SCHEMABRIDGE_SEMANTIC_RECONCILER_RETENTION_DAYS=30
SCHEMABRIDGE_SEMANTIC_RECONCILER_MAINTENANCE_BATCH_SIZE=100
# API-only HMAC key; inject one stable independent secret in every API replica.
# Never reuse a bearer, pseudonymization, control-audit, or identity key.
# SCHEMABRIDGE_INVENTORY_CURSOR_SIGNING_KEY=
# Catalog-indexer-only settings. Managed indexers resolve lease-bound DataHub
# connector documents from their catalog-only directory; they receive no global
# DataHub endpoint/token, OpenAI key, or source database credential. The
# synthetic map is for bounded local scale drills.
SCHEMABRIDGE_CATALOG_INDEXER_ID=catalog-local
SCHEMABRIDGE_CATALOG_POLL_INTERVAL_MS=1000
SCHEMABRIDGE_CATALOG_LEASE_SECONDS=120
SCHEMABRIDGE_CATALOG_SOURCE_TIMEOUT_SECONDS=15
SCHEMABRIDGE_CATALOG_PAGE_SIZE=50
SCHEMABRIDGE_CATALOG_MAX_RESPONSE_BYTES=4194304
SCHEMABRIDGE_CATALOG_STALE_AFTER_SECONDS=900
SCHEMABRIDGE_CATALOG_SYNTHETIC_ASSET_COUNTS={}

# Development/demo PostgreSQL only. Never inject DATABASE_URL into a managed
# execution or profile worker; managed source access is connector-routed.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
POSTGRES_DB=schemabridge
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_READER_USER=schemabridge_reader
POSTGRES_READER_PASSWORD=schemabridge_reader
DATABASE_URL=postgresql://schemabridge_reader:schemabridge_reader@localhost:55433/schemabridge

# Development/demo DataHub Core / MCP only. Never inject DATAHUB_GMS_URL or
# DATAHUB_GMS_TOKEN into a managed catalog indexer; its route is connector-bound.
DATAHUB_GMS_URL=http://localhost:8080
# DATAHUB_GMS_TOKEN=
TOOLS_IS_MUTATION_ENABLED=false
SAVE_DOCUMENT_TOOL_ENABLED=false
DATAHUB_MCP_DOCUMENT_TOOLS_DISABLED=true
LOGICAL_MODELS_ENABLED=true

# Optional M11/M27 live typed-intent adapter. External AI remains disabled by
# default. M24 API/worker processes do not consume the OpenAI key; do not inject
# it into those workloads. For managed Query Studio, supply an independent
# high-entropy signing key of at least 32 bytes; never reuse another signing key.
# OPENAI_API_KEY=
# SCHEMABRIDGE_LLM_MODEL=
SCHEMABRIDGE_QUERY_STUDIO_AI_MODE=disabled
SCHEMABRIDGE_QUERY_STUDIO_AI_MODEL=gpt-5-nano-2025-08-07
SCHEMABRIDGE_QUERY_STUDIO_AI_REGION=global
# SCHEMABRIDGE_QUERY_STUDIO_SIGNING_KEY=
