# Copy this file to .streamlit/secrets.toml only in an OIDC-enabled deployment.
# Never commit the populated file. The redirect URI must be the absolute public
# application URL followed by /oauth2callback. Every value below is an invalid
# placeholder: managed startup rejects this file until the secret manager replaces it.

[auth]
redirect_uri = "https://schemabridge.example.com/oauth2callback"
cookie_secret = "replace-with-at-least-32-random-bytes"

[auth.corporate]
client_id = "replace-with-oidc-client-id"
client_secret = "replace-with-oidc-client-secret"
server_metadata_url = "https://idp.example.com/.well-known/openid-configuration"

# client_id must equal SCHEMABRIDGE_OIDC_AUDIENCE. The metadata URL origin must
# equal SCHEMABRIDGE_OIDC_ISSUER. Keep expose_tokens unset.
